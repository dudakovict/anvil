# Copy to .env and adjust. For host-run dev: set -a; . ./.env; set +a  (or use direnv)

APP_ENV=dev
DEBUG=true

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
# WriteTimeout MUST be greater than HTTP_REQUEST_TIMEOUT (validated at boot).
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=120s
HTTP_REQUEST_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576
HTTP_CORS_ALLOWED_ORIGINS=

DB_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MIGRATE=true
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m
DB_SLOW_QUERY_THRESHOLD=200ms

AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL=15m

OTEL_ENABLED=false
OTEL_SERVICE_NAME=anvil
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLE_RATIO=1.0
